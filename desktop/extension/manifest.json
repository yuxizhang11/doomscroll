{
  "manifest_version": 3,
  "name": "Doomscroll Blocker",
  "version": "0.1.0",
  "key": "",
  "description": "Meldet der Doomscroll-Blocker-App auf diesem Rechner, welche Seite offen ist, und sperrt Instagram Reels, YouTube Shorts, TikTok und Porno-Seiten, wenn die App es verlangt.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Doomscroll Blocker"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "doomscroll-blocker@doomscroll.local",
      "strict_min_version": "121.0"
    }
  }
}
